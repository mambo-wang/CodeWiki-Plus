{
  "mcpServers": {
    "codewiki": {
      "command": ".venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "codewiki.mcp.server"
      ],
      "cwd": "${workspaceRoot}"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \".qoder/hooks/task_session_start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \".qoder/hooks/capture_session_end.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m codewiki.mcp._ide_hook --enable",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
