{
  "mcpServers": {
    "codewiki": {
      "command": ".venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "codewiki.mcp.server"
      ],
      "cwd": "${workspaceRoot}"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe \"D:\\PersonalData\\wangbao\\CodeWiki-Plus\\.qoder\\hooks\\task_session_start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe \"D:\\PersonalData\\wangbao\\CodeWiki-Plus\\.qoder\\hooks\\capture_session_end.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
